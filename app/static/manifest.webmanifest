    ],
    "share_target": {
        "action": "/ministerio/compartilhar-cifra",
        "method": "POST",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "titulo",
            "text": "texto",
            "url": "link"
        }
    },
    "icons": [
