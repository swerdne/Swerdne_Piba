{
    "name": "TyBenson",
    "short_name": "TyBenson",
    "description": "Gestao de comunidades, ministerios e escalas.",
    "start_url": "/dashboard",
    "scope": "/",
    "display": "standalone",
    "background_color": "#02030F",
    "theme_color": "#4f46e5",
    "orientation": "portrait-primary",
    "share_target": {
        "action": "/ministerio/compartilhar-cifra",
        "method": "POST",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "titulo",
            "text": "texto",
            "url": "link"
        }
    },
    "icons": [
        {
            "src": "/static/img/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/img/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/static/img/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
