FLASK_CONFIG=development
SECRET_KEY=coloque-uma-chave-secreta-aqui
DATABASE_URL=sqlite:///dev.db

# Credenciais OAuth do Google (criadas em https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# true = login com Google simulado localmente (nao chama a API do Google de verdade).
# Ignorado automaticamente quando FLASK_CONFIG=production.
MOCK_GOOGLE_OAUTH=false

# E-mail (notificacoes da Escala Rapida, ver app/emailing.py).
# Exemplo com Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true,
# MAIL_USERNAME=seu-email@gmail.com, MAIL_PASSWORD=senha de app (nao a senha normal da conta).
# Sem essas variaveis, o botao "Notificar" avisa que o e-mail nao esta configurado
# em vez de travar o servidor.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# SMS (notificacoes da Escala Rapida, ver app/sms.py). Conta em https://www.twilio.com
# TWILIO_FROM_NUMBER e o numero Twilio habilitado para SMS (formato +1XXXXXXXXXX).
# Sem essas variaveis, o botao "Notificar" avisa que o SMS nao esta configurado
# em vez de travar o servidor.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
