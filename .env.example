FLASK_CONFIG=development
SECRET_KEY=coloque-uma-chave-secreta-aqui

# Banco de dados. Em development, se DATABASE_URL nao estiver definida, cai
# no SQLite local (sqlite:///dev.db) automaticamente -- so precisa preencher
# se for apontar pra um Postgres externo (Neon, Supabase, etc.), inclusive em
# development (util pra testar a integracao antes de configurar producao).
# Exemplo de URL Postgres (troque usuario/senha/host/banco pelos seus):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL=sqlite:///dev.db

# Credenciais OAuth do Google (criadas em https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# true = login com Google simulado localmente (nao chama a API do Google de verdade).
# Ignorado automaticamente quando FLASK_CONFIG=production.
MOCK_GOOGLE_OAUTH=false

# E-mail (notificacoes da Escala Rapida, ver app/emailing.py). API HTTP da
# Resend, nao SMTP -- SMTP e bloqueado pela rede de saida do Render (e da
# maioria dos PaaS gratuitos). Conta em https://resend.com, chave de API em
# https://resend.com/api-keys. RESEND_FROM_EMAIL precisa ser de um dominio
# verificado na Resend (https://resend.com/domains) pra enviar pra qualquer
# destinatario -- sem dominio verificado, so envia pro proprio e-mail de
# cadastro da conta Resend (modo sandbox).
# Sem essas variaveis, o botao "Notificar" avisa que o e-mail nao esta configurado
# em vez de travar o servidor.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS (notificacoes da Escala Rapida, ver app/sms.py). Conta em https://www.twilio.com
# TWILIO_FROM_NUMBER e o numero Twilio habilitado para SMS (formato +1XXXXXXXXXX).
# Sem essas variaveis, o botao "Notificar" avisa que o SMS nao esta configurado
# em vez de travar o servidor.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
